{
  "name": "zdm-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:status": "node scripts/dev-status.mjs",
    "integration:dev": "node scripts/run-integration.mjs dev:all",
    "integration:status": "node scripts/run-integration.mjs dev:status",
    "integration:verify": "node scripts/run-integration.mjs verify:local",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:cached": "vue-tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/vue-tsc.tsbuildinfo",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint",
    "lint:changed": "eslint --cache --cache-location node_modules/.cache/eslint",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "stylelint": "stylelint \"src/**/*.{css,vue}\" --cache --cache-location node_modules/.cache/stylelint",
    "stylelint:changed": "stylelint --cache --cache-location node_modules/.cache/stylelint",
    "test:unit": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:related": "vitest related --run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --workers=1",
    "test:e2e:chrome": "PLAYWRIGHT_CHANNEL=chrome playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "check:changed": "node scripts/check-changed.mjs",
    "check:fast": "npm run check:changed",
    "check:ui": "playwright test",
    "check:backend": "npm run backend:test",
    "check:full": "npm run verify",
    "git:state": "node scripts/git-workflow-state.mjs",
    "git:delivery-check": "node scripts/git-workflow-state.mjs --require-synced --require-integrated",
    "git:integration:sync": "node scripts/sync-integration.mjs",
    "quality": "npm run typecheck && npm run lint && npm run stylelint && npm run format:check && npm run test:unit && npm run test:scripts",
    "verify": "npm run quality && npm run build:app && npm run test:e2e && npm run backend:quality",
    "verify:local": "npm run quality && npm run build:app && npm run test:e2e:chrome && npm run backend:quality",
    "backend:dev": "docker compose up backend",
    "backend:logs": "docker compose logs --tail=200 backend",
    "backend:restart": "docker compose restart backend",
    "backend:test": "docker compose run --rm --no-deps backend-tools mvn -B test",
    "backend:quality": "docker compose run --rm --no-deps backend-tools mvn -B test checkstyle:check spotbugs:check jacoco:report",
    "backend:compile": "docker compose run --rm --no-deps backend-tools mvn -B -DskipTests compile",
    "backend:dev:docker": "npm run backend:dev",
    "backend:test:docker": "npm run backend:test",
    "backend:quality:docker": "npm run backend:quality",
    "backend:dev:local": "cd backend && mvn spring-boot:run",
    "backend:test:local": "cd backend && mvn -B test",
    "backend:quality:local": "cd backend && mvn -B test checkstyle:check spotbugs:check jacoco:report",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "tdesign-icons-vue-next": "^0.4.4",
    "tdesign-vue-next": "^1.20.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.2",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "2.2.7",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
